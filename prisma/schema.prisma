// Prisma schema for LodgeIQ
// This defines the database structure for hotels, inspections, and checklists

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - Represents inspectors, managers, and other users
// Extended to support Auth.js authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(INSPECTOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Demo and planning
  isDemo Boolean @default(false) // The shared demo account. It can never write data.
  region String? // Area an inspector covers, for example "Kenya"

  // App relations
  inspections Inspection[] // Inspections created by this user
  visits      Visit[] // Planned visits assigned to this user

  @@map("users")
}

// Auth.js Account model - OAuth accounts linked to users
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Auth.js Session model - Active user sessions
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Auth.js VerificationToken model - For passwordless login
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Enum for user roles
enum UserRole {
  INSPECTOR // Field inspector who performs inspections
  MANAGER // Manager who reviews inspections
  ADMIN // System administrator
}

// Hotel model - Represents properties to be inspected
model Hotel {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  country     String
  phone       String?
  email       String?
  website     String?
  description String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Portfolio details
  kind              String? // For example "Tented camp"
  sizeLabel         String? // For example "18 tents"
  photoUrl          String?
  countryCode       String? // ISO 3166 alpha 3, matches the globe data (KEN, TZA, ...)
  region            String? // Kenya, Tanzania, Europe, Asia Pacific, Americas, Middle East
  visitStandardDays Int     @default(90)
  isSample          Boolean @default(false) // Sample data that the nightly reseed replaces

  // Relations
  inspections Inspection[] // All inspections for this hotel
  followUps   FollowUp[]
  visits      Visit[]
  activities  Activity[]

  @@map("hotels")
}

// Inspection model - Represents a single inspection visit to a hotel
model Inspection {
  id               String           @id @default(cuid())
  hotelId          String
  inspectorId      String
  inspectionDate   DateTime         @default(now())
  overallRating    Float? // Composite score (0-5 scale)
  status           InspectionStatus @default(IN_PROGRESS)
  notes            String? // General notes about the inspection
  followUpRequired Boolean          @default(false)
  followUpNotes    String?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  hotel             Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inspector         User               @relation(fields: [inspectorId], references: [id])
  inspectionResults InspectionResult[] // Individual checklist item results

  @@map("inspections")
}

// Enum for inspection status
enum InspectionStatus {
  IN_PROGRESS // Currently being conducted
  COMPLETED // Finished and ready for review
  APPROVED // Reviewed and approved by manager
  REJECTED // Needs re-inspection
}

// ChecklistItem model - Represents standardized checklist items
// These are the template items that inspectors check for each hotel
model ChecklistItem {
  id          String   @id @default(cuid())
  category    String // e.g., "Room Quality", "Cleanliness", "Safety", "Staff"
  itemName    String // e.g., "Bed comfort", "Bathroom cleanliness"
  description String? // Detailed description of what to check
  weight      Float    @default(1.0) // Importance weight for scoring (1.0 = normal)
  isActive    Boolean  @default(true) // Can be disabled without deleting
  order       Int      @default(0) // Display order within category
  slug        String?  @unique // Stable id for the seed and the UI, for example "door-locks"
  evidence    String? // Sample evidence photo path, may be empty
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  inspectionResults InspectionResult[] // Results from inspections using this item
  followUps         FollowUp[]

  @@map("checklist_items")
}

// InspectionResult model - Links inspections to checklist items with results
// This stores the actual inspection data for each checklist item
model InspectionResult {
  id              String       @id @default(cuid())
  inspectionId    String
  checklistItemId String
  result          ResultStatus @default(PENDING)
  rating          Float? // Optional numeric rating (0-5 scale)
  notes           String? // Inspector's notes for this specific item
  photoUrls       String[] // Array of photo URLs stored in cloud storage
  category        String? // Category name (Cleanliness, Safety, Amenities)
  categoryRating  Float? // Rating specific to this category (0-5 scale)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  inspection    Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id])

  // Ensure one result per checklist item per inspection
  @@unique([inspectionId, checklistItemId])
  @@map("inspection_results")
}

// Enum for checklist item results
enum ResultStatus {
  PENDING // Not yet checked
  PASS // Meets standards
  FAIL // Does not meet standards
  NEEDS_IMPROVEMENT // Acceptable but could be better
  NOT_APPLICABLE // Item doesn't apply to this property
}

// FollowUp model - Work a property owes after a check failed
model FollowUp {
  id              String         @id @default(cuid())
  hotelId         String
  checklistItemId String
  inspectionId    String?
  text            String
  photoUrl        String?
  status          FollowUpStatus @default(OPEN)
  ownerName       String?
  note            String?
  dueDate         DateTime
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id])

  @@map("follow_ups")
}

enum FollowUpStatus {
  OPEN // Not assigned yet
  IN_PROGRESS // Assigned and being fixed
  DONE // Fixed
}

// Visit model - A planned inspection visit in the schedule
model Visit {
  id          String   @id @default(cuid())
  hotelId     String
  inspectorId String
  date        DateTime
  createdAt   DateTime @default(now())

  hotel     Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inspector User  @relation(fields: [inspectorId], references: [id])

  @@map("visits")
}

// Activity model - Recent happenings shown in the activity bell
model Activity {
  id            String   @id @default(cuid())
  hotelId       String?
  actorName     String
  actorInitials String
  text          String
  createdAt     DateTime @default(now())

  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("activities")
}
